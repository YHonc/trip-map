# Default: no network credentials required. Real integration is opt-in.
NEXT_PUBLIC_MAP_PROVIDER=mock
# Browser JS API key (domain restricted); never put server keys here.
NEXT_PUBLIC_AMAP_JS_KEY=
# Server-only Web service key and JS API security code.
AMAP_WEB_KEY=
AMAP_SECURITY_CODE=
# Optional server-only defaults; settings in the unified user data directory take precedence.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
